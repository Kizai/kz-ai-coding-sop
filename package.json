{
  "name": "kz-sop",
  "version": "0.1.0",
  "description": "Kizai's controlled AI Coding SOP toolkit for Superpowers-first agent-based software development.",
  "type": "module",
  "bin": {
    "kz-sop": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "skills",
    "README.md",
    "LICENSE",
