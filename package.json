    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup src/cli.ts --format esm",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai-coding",
    "controlled-ai-coding",
    "codex",
    "claude-code",
    "agents",
    "superpowers",
    "skills",
    "sop",
    "scaffold"
  ],
  "author": "Kizai",
  "license": "MIT",
  "homepage": "https://github.com/Kizai/kz-ai-coding-sop#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kizai/kz-ai-coding-sop.git"
  },
  "bugs": {
    "url": "https://github.com/Kizai/kz-ai-coding-sop/issues"
  },
  "devDependencies": {
    "@types/node": "latest",
    "tsx": "latest",
    "tsup": "latest",
    "typescript": "latest"
  }
